WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[* FILTER (LENGTH((IS_LIST(CURRENT.`subItems`) ? CURRENT.`subItems` : [])[* FILTER ((CURRENT.`openQuantity` > @var5) || (CURRENT.`openQuantity` == @var6))]) > 0)]
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    )
  })
}

