WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[*]
      FILTER (LENGTH((
        FOR v_subItems1
        IN (IS_LIST(v_item1.`subItems`) ? v_item1.`subItems` : [])
        FILTER (@var5 IN v_subItems1.`subItems`[*].`itemNumber`)
        LIMIT 1
        RETURN true
      )) > 0)
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    ),
    @var6: {
      "count": FIRST(
        FOR v_item2
        IN (
          FOR v_root2, v_edge2, v_path2 IN @var7..@var8 OUTBOUND v_shipment1 @@shipments_deliveries
          FILTER v_root2._key != null
          FOR v_item3 IN v_root2.`items`[*]
          FILTER (LENGTH((
            FOR v_subItems2
            IN (IS_LIST(v_item3.`subItems`) ? v_item3.`subItems` : [])
            FILTER (@var9 IN v_subItems2.`subItems`[*].`itemNumber`)
            LIMIT 1
            RETURN true
          )) > 0)
          RETURN v_item3
        )
        COLLECT WITH COUNT INTO v_count1
        RETURN v_count1
      )
    }
  })
}

