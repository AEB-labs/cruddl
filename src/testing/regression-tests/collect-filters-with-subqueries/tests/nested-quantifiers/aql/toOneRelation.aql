WITH @@deliveries
LET v_order1 = FIRST((
  FOR v_order2
  IN @@orders
  FILTER (v_order2.`orderNumber` == @var1)
  LIMIT @var2
  RETURN v_order2
))
RETURN {
  "Order": (IS_NULL(v_order1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_order1 @@orders_delivery
      FOR v_item1 IN v_root1.`items`[*]
      FILTER (LENGTH((
        FOR v_subItems1
        IN (IS_LIST(v_item1.`subItems`) ? v_item1.`subItems` : [])
        FILTER (LENGTH(v_subItems1.`subItems`) == @var5)
        LIMIT 1
        RETURN true
      )) > 0)
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    ),
    @var6: {
      "count": FIRST(
        FOR v_item2
        IN (
          FOR v_root2, v_edge2, v_path2 IN @var7..@var8 OUTBOUND v_order1 @@orders_delivery
          FOR v_item3 IN v_root2.`items`[*]
          FILTER (LENGTH((
            FOR v_subItems2
            IN (IS_LIST(v_item3.`subItems`) ? v_item3.`subItems` : [])
            FILTER (LENGTH(v_subItems2.`subItems`) == @var9)
            LIMIT 1
            RETURN true
          )) > 0)
          RETURN v_item3
        )
        COLLECT WITH COUNT INTO v_count1
        RETURN v_count1
      )
    }
  })
}

