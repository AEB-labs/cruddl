WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[* FILTER (FIRST(
        FOR v_item2
        IN (
          FOR v_subItems1
          IN (IS_LIST(CURRENT.`subItems`) ? CURRENT.`subItems` : [])
          FILTER !((LENGTH((IS_LIST(v_subItems1.`subItems`) ? v_subItems1.`subItems` : [])[* FILTER (CURRENT.`itemNumber` >= UPPER(@var5) && CURRENT.`itemNumber` < LOWER(@var6)) && (LEFT(CURRENT.`itemNumber`, LENGTH(@var7)) == @var8)]) == 0))
          RETURN v_subItems1
        )
        COLLECT WITH COUNT INTO v_count1
        RETURN v_count1
      ) == @var9)]
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    )
  })
}
