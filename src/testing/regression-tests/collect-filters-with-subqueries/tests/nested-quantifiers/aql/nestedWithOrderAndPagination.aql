WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "sorted": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[*]
      FILTER (LENGTH((
        FOR v_subItems1
        IN (IS_LIST(v_item1.`subItems`) ? v_item1.`subItems` : [])
        FILTER !((LENGTH((IS_LIST(v_subItems1.`subItems`) ? v_subItems1.`subItems` : [])[* FILTER (CURRENT.`itemNumber` >= UPPER(@var5) && CURRENT.`itemNumber` < LOWER(@var6)) && (LEFT(CURRENT.`itemNumber`, LENGTH(@var7)) == @var8)]) == 0))
        LIMIT 1
        RETURN true
      )) == 0)
      SORT (v_item1.`itemNumber`)  DESC
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    ),
    "paginated": (
      FOR v_root2, v_edge2, v_path2 IN @var9..@var10 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root2._key != null
      FOR v_item2 IN v_root2.`items`[*]
      FILTER (LENGTH((
        FOR v_subItems2
        IN (IS_LIST(v_item2.`subItems`) ? v_item2.`subItems` : [])
        FILTER !((LENGTH((IS_LIST(v_subItems2.`subItems`) ? v_subItems2.`subItems` : [])[* FILTER (CURRENT.`itemNumber` >= UPPER(@var11) && CURRENT.`itemNumber` < LOWER(@var12)) && (LEFT(CURRENT.`itemNumber`, LENGTH(@var13)) == @var14)]) == 0))
        LIMIT 1
        RETURN true
      )) == 0)
      SORT (v_item2.`itemNumber`)
      LIMIT @var15, @var16
      RETURN {
        "itemNumber": v_item2.`itemNumber`
      }
    ),
    "firstOnly": (
      FOR v_root3, v_edge3, v_path3 IN @var17..@var18 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root3._key != null
      FOR v_item3 IN v_root3.`items`[*]
      FILTER (LENGTH((
        FOR v_subItems3
        IN (IS_LIST(v_item3.`subItems`) ? v_item3.`subItems` : [])
        FILTER !((LENGTH((IS_LIST(v_subItems3.`subItems`) ? v_subItems3.`subItems` : [])[* FILTER (CURRENT.`itemNumber` >= UPPER(@var19) && CURRENT.`itemNumber` < LOWER(@var20)) && (LEFT(CURRENT.`itemNumber`, LENGTH(@var21)) == @var22)]) == 0))
        LIMIT 1
        RETURN true
      )) == 0)
      LIMIT @var23
      RETURN {
        "itemNumber": v_item3.`itemNumber`
      }
    )
  })
}

