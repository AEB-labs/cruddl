WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[*]
      FILTER (LENGTH((
        FOR v_tags1
        IN (IS_LIST((IS_NULL(v_item1.`articleNumber`) ? null : FIRST((
          FOR v_article1
          IN @@articles
          FILTER ((v_article1.`articleNumber` > NULL) && (v_article1.`articleNumber` == v_item1.`articleNumber`))
          LIMIT @var5
          RETURN v_article1
        ))).`tags`) ? (IS_NULL(v_item1.`articleNumber`) ? null : FIRST((
          FOR v_article2
          IN @@articles
          FILTER ((v_article2.`articleNumber` > NULL) && (v_article2.`articleNumber` == v_item1.`articleNumber`))
          LIMIT @var6
          RETURN v_article2
        ))).`tags` : [])
        FILTER (v_tags1 == @var7)
        LIMIT 1
        RETURN true
      )) > 0)
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    )
  })
}

