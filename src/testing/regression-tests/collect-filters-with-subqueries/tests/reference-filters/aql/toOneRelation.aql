WITH @@deliveries
LET v_order1 = FIRST((
  FOR v_order2
  IN @@orders
  FILTER (v_order2.`orderNumber` == @var1)
  LIMIT @var2
  RETURN v_order2
))
RETURN {
  "Order": (IS_NULL(v_order1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_order1 @@orders_delivery
      FOR v_item1 IN v_root1.`items`[*]
      FILTER ((IS_NULL(v_item1.`articleNumber`) ? null : FIRST((
        FOR v_article1
        IN @@articles
        FILTER ((v_article1.`articleNumber` > NULL) && (v_article1.`articleNumber` == v_item1.`articleNumber`))
        LIMIT @var5
        RETURN v_article1
      ))).`isDangerousGoods` == @var6)
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    )
  })
}

