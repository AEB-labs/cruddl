WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[* FILTER ((IS_NULL(CURRENT.`articleNumber`) ? null : FIRST((
        FOR v_article1
        IN @@articles
        FILTER ((v_article1.`articleNumber` > NULL) && (v_article1.`articleNumber` == CURRENT.`articleNumber`))
        LIMIT @var5
        RETURN v_article1
      ))).`isDangerousGoods` == @var6)]
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    ),
    @var7: {
      "count": FIRST(
        FOR v_item2
        IN (
          FOR v_root2, v_edge2, v_path2 IN @var8..@var9 OUTBOUND v_shipment1 @@shipments_deliveries
          FILTER v_root2._key != null
          FOR v_item3 IN v_root2.`items`[* FILTER ((IS_NULL(CURRENT.`articleNumber`) ? null : FIRST((
            FOR v_article2
            IN @@articles
            FILTER ((v_article2.`articleNumber` > NULL) && (v_article2.`articleNumber` == CURRENT.`articleNumber`))
            LIMIT @var10
            RETURN v_article2
          ))).`isDangerousGoods` == @var11)]
          RETURN v_item3
        )
        COLLECT WITH COUNT INTO v_count1
        RETURN v_count1
      )
    }
  })
}
