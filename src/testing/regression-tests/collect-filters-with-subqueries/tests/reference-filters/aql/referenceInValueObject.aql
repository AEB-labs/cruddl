WITH @@deliveries
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "allItems": (
      FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_deliveries
      FILTER v_root1._key != null
      FOR v_item1 IN v_root1.`items`[* FILTER ((IS_NULL(CURRENT.`packaging`.`materialArticleNumber`) ? null : FIRST((
        FOR v_materialArticle1
        IN @@articles
        FILTER ((v_materialArticle1.`articleNumber` > NULL) && (v_materialArticle1.`articleNumber` == CURRENT.`packaging`.`materialArticleNumber`))
        LIMIT @var5
        RETURN v_materialArticle1
      ))).`description` == @var6)]
      RETURN {
        "itemNumber": v_item1.`itemNumber`
      }
    )
  })
}
