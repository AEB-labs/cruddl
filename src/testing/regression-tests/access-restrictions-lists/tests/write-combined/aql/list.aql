RETURN {
  "allShipments": (
    FOR v_shipment1
    IN (
      FOR v_item1
      IN @@shipments
      FILTER (((v_item1.`tags` ANY IN @var1) && (v_item1.`category` == @var2)) || (v_item1.`tags` ANY IN @var3))
      RETURN v_item1
    )
    SORT (v_shipment1.`name`)
    RETURN {
      "name": v_shipment1.`name`,
      "tags": v_shipment1.`tags`[*],
      "category": v_shipment1.`category`
    }
  )
}

