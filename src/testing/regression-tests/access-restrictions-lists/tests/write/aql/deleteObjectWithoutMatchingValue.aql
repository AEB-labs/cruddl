WITH @@shipments
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @v_ids1
  REMOVE v_shipment2
  IN @@shipments
  RETURN OLD
))
RETURN (IS_NULL(v_shipment1) ? null : {
  "name": v_shipment1.`name`
})

