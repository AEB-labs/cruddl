RETURN (
  FOR v_shipment1
  IN (
    FOR v_item1
    IN @@shipments
    FILTER ((v_item1.`tags` ANY IN @var1) || (v_item1.`tags` ANY IN @var2))
    RETURN v_item1
  )
  FILTER (v_shipment1._key == @var3)
  LIMIT @var4
  RETURN v_shipment1._key
)

