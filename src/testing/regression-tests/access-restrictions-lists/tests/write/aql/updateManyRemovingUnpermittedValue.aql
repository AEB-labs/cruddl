  FOR v_shipment1
  IN [
    FIRST(
      LET v_entity1 = DOCUMENT(@@shipments, @var1)
      RETURN (((v_entity1.`tags` ANY IN @var2) || (v_entity1.`tags` ANY IN @var3)) ? v_entity1 : null)
    ),
    FIRST(
      LET v_entity2 = DOCUMENT(@@shipments, @var4)
