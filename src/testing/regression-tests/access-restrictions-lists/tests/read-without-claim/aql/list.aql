RETURN {
  "allShipments": (
    FOR v_shipment1
    IN (
      FOR v_item1
      IN @@shipments
      FILTER (v_item1.`tags` ANY IN @var1)
      RETURN v_item1
    )
    SORT (v_shipment1.`name`)
    RETURN {
      "name": v_shipment1.`name`,
      "tags": v_shipment1.`tags`[*]
    }
  )
}

