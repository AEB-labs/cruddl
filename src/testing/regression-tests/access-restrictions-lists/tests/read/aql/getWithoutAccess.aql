LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN (
    FOR v_item1
    IN @@shipments
    FILTER ((v_item1.`tags` ANY IN @var1) || (v_item1.`tags` ANY IN @var2))
    RETURN v_item1
  )
  FILTER (v_shipment2._key == @var3)
  LIMIT @var4
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "name": v_shipment1.`name`
  })
}

