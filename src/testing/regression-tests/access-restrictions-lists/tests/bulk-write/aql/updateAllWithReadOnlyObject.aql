RETURN (FIRST(
  FOR v_item1
  IN (
    FOR v_shipment1
    IN (
      FOR v_item2
      IN @@shipments
      FILTER ((v_item2.`tags` ANY IN @var1) || (v_item2.`tags` ANY IN @var2))
      RETURN v_item2
    )
    FILTER !((v_shipment1.`tags` ANY IN @var3))
    LIMIT @var4
    RETURN v_shipment1
  )
  COLLECT WITH COUNT INTO v_count1
  RETURN v_count1
) == 0)

// Peak memory usage: 0 bytes

// ----------------------------------------------------------------

RETURN (FIRST(
  FOR v_item1
  IN (
    FOR v_currentEntity1
    IN (
      FOR v_item2
      IN @@shipments
      FILTER ((v_item2.`tags` ANY IN @var1) || (v_item2.`tags` ANY IN @var2))
      RETURN v_item2
    )
    FILTER !((v_currentEntity1.`tags` ANY IN @var3))
    LIMIT @var4
    RETURN v_currentEntity1
  )
  COLLECT WITH COUNT INTO v_count1
  RETURN v_count1
) == 0)

// ----------------------------------------------------------------

RETURN (
  FOR v_currentEntity1
  IN (
    FOR v_item1
    IN @@shipments
    FILTER ((v_item1.`tags` ANY IN @var1) || (v_item1.`tags` ANY IN @var2))
    RETURN v_item1
  )
  UPDATE v_currentEntity1
  WITH {
    "name": @var3,
    "updatedAt": @var4
  }
  IN @@shipments
  OPTIONS { mergeObjects: false }
  RETURN NEW._key
)

// ----------------------------------------------------------------

WITH @@shipments
RETURN (
  FOR v_shipment1
  IN (
    FOR v_id1
    IN @v_updatedIds1
    LET v_entity1 = DOCUMENT(@@shipments, v_id1)
    RETURN (((v_entity1.`tags` ANY IN @var1) || (v_entity1.`tags` ANY IN @var2)) ? v_entity1 : null)
  )
  RETURN {
    "name": v_shipment1.`name`
  }
)

// ----------------------------------------------------------------

WITH @@shipments
RETURN {
  "updateAllShipments": @v_updateAllShipments1
}
