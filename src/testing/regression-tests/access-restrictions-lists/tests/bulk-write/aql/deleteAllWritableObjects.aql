RETURN (
  FOR v_shipment1
  IN (
    FOR v_shipment2
    IN (
      FOR v_item1
      IN @@shipments
      FILTER ((v_item1.`tags` ANY IN @var1) || (v_item1.`tags` ANY IN @var2))
      RETURN v_item1
    )
    FILTER (v_shipment2.`name` IN @var3)
    REMOVE v_shipment2
    IN @@shipments
    RETURN OLD
  )
  RETURN {}
)

