RETURN (FIRST(
  FOR v_item1
  IN (
    FOR v_shipment1
    IN (
      FOR v_shipment2
      IN (
        FOR v_item2
        IN @@shipments
        FILTER ((v_item2.`tags` ANY IN @var1) || (v_item2.`tags` ANY IN @var2))
        RETURN v_item2
      )
      FILTER (v_shipment2.`name` IN @var3)
      RETURN v_shipment2
    )
    FILTER !((v_shipment1.`tags` ANY IN @var4))
    LIMIT @var5
    RETURN v_shipment1
  )
  COLLECT WITH COUNT INTO v_count1
  RETURN v_count1
) == 0)

