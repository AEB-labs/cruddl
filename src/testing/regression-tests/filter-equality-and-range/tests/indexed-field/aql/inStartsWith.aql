RETURN {
  "allUsers": (
    FOR v_user1
    IN @@users
    FILTER ((v_user1.`username` IN @var1) && (v_user1.`username` >= UPPER(@var2) && v_user1.`username` < LOWER(@var3)) && (LEFT(v_user1.`username`, LENGTH(@var4)) == @var5))
    SORT (v_user1.`username`)
    RETURN {
      "username": v_user1.`username`
    }
  )
}
