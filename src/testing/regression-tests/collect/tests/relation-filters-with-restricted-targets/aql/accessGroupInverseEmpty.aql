WITH @@deliveries
RETURN {
  "allHandlingUnits": (
    FOR v_handlingUnit1
    IN (
      FOR v_item1
      IN @@handlingUnits
      FILTER (v_item1.`accessGroup` IN @var1)
      RETURN v_item1
    )
    FILTER (FIRST(
      FOR v_item2
      IN (
        FOR v_item3
        IN INBOUND v_handlingUnit1 @@deliveries_handlingUnits
        FILTER (v_item3.`accessGroup` IN @var2)
        FILTER v_item3._key != null
        RETURN v_item3
      )
      COLLECT WITH COUNT INTO v_count1
      RETURN v_count1
    ) == @var3)
    SORT (v_handlingUnit1.`handlingUnitNumber`)
    RETURN {
      "handlingUnitNumber": v_handlingUnit1.`handlingUnitNumber`
    }
  )
}

