WITH @@handlingUnits
RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN (
      FOR v_item1
      IN @@deliveries
      FILTER (v_item1.`location`.`identCode` IN @var1)
      RETURN v_item1
    )
    FILTER (FIRST(
      FOR v_item2
      IN (
        FOR v_item3
        IN OUTBOUND v_delivery1 @@deliveries_handlingUnits
        FILTER (v_item3.`location`.`identCode` IN @var2)
        FILTER v_item3._key != null
        RETURN v_item3
      )
      COLLECT WITH COUNT INTO v_count1
      RETURN v_count1
    ) == @var3)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

