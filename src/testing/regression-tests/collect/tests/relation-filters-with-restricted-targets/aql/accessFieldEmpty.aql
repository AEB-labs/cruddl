RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN (
      FOR v_item1
      IN @@deliveries
      FILTER (v_item1.`location`.`identCode` IN @var1)
      RETURN v_item1
    )
    FILTER (LENGTH(v_delivery1.`handlingUnits`) == @var2)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

