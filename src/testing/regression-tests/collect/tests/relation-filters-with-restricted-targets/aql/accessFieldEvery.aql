WITH @@handlingUnits
RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN (
      FOR v_item1
      IN @@deliveries
      FILTER (v_item1.`location`.`identCode` IN @var1)
      RETURN v_item1
    )
    FILTER (LENGTH((
      FOR v_item2
      IN OUTBOUND v_delivery1 @@deliveries_handlingUnits
      FILTER (v_item2.`location`.`identCode` IN @var2)
      FILTER v_item2._key != null
      RETURN v_item2
    )[* FILTER !((CURRENT.`handlingUnitNumber` IN @var3))]) == 0)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

