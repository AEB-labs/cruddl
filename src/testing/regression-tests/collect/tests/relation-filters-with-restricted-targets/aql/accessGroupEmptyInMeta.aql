WITH @@handlingUnits
RETURN {
  @var1: {
    "count": FIRST(
      FOR v_item1
      IN (
        FOR v_delivery1
        IN (
          FOR v_item2
          IN @@deliveries
          FILTER (v_item2.`accessGroup` IN @var2)
          RETURN v_item2
        )
        FILTER (FIRST(
          FOR v_item3
          IN (
            FOR v_item4
            IN OUTBOUND v_delivery1 @@deliveries_handlingUnits
            FILTER (v_item4.`accessGroup` IN @var3)
            FILTER v_item4._key != null
            RETURN v_item4
          )
          COLLECT WITH COUNT INTO v_count1
          RETURN v_count1
        ) == @var4)
        RETURN v_delivery1
      )
      COLLECT WITH COUNT INTO v_count2
      RETURN v_count2
    )
  }
}

