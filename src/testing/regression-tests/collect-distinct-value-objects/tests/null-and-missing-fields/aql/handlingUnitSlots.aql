WITH @@handlingUnits
LET v_shipment1 = FIRST((
  FOR v_shipment2
  IN @@shipments
  FILTER (v_shipment2.`shipmentNumber` == @var1)
  LIMIT @var2
  RETURN v_shipment2
))
RETURN {
  "Shipment": (IS_NULL(v_shipment1) ? null : {
    "handlingUnitSlots": (
      FOR v_warehouseSlot1
      IN (
        FOR v_item1
        IN (
          FOR v_root1, v_edge1, v_path1 IN @var3..@var4 OUTBOUND v_shipment1 @@shipments_handlingUnits
          FILTER v_root1._key != null
          RETURN v_root1.`slot`
        )
        FILTER v_item1 != null
        COLLECT v_distinct1 = v_item1 OPTIONS { method: "hash" }
        RETURN v_distinct1
      )
      RETURN {
        "warehouse": v_warehouseSlot1.`warehouse`,
        "level": v_warehouseSlot1.`level`
      }
    ),
    "handlingUnitSlotCount": FIRST(
      FOR v_item2
      IN (
        FOR v_root2, v_edge2, v_path2 IN @var5..@var6 OUTBOUND v_shipment1 @@shipments_handlingUnits
        FILTER v_root2._key != null
        RETURN v_root2.`slot`
      )
      FILTER v_item2 != null
      COLLECT AGGREGATE v_count_distinct1 = COUNT_DISTINCT(v_item2)
      RETURN v_count_distinct1
    )
  })
}

