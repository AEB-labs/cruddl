RETURN {
  "allOrders": (
    FOR v_order1
    IN @@orders
    SORT (v_order1.`orderNumber`)
    RETURN {
      "orderNumber": v_order1.`orderNumber`,
      "items": v_order1.`items`[* FILTER (@var1 IN CURRENT.`tags`) RETURN {
        "itemNumber": CURRENT.`itemNumber`
      }]
    }
  )
}

