RETURN {
  "allOrders": (
    FOR v_order1
    IN @@orders
    FILTER (FIRST(
      FOR v_item1
      IN (
        FOR v_items1
        IN (IS_LIST(v_order1.`items`) ? v_order1.`items` : [])
        FILTER !(((v_items1.`itemNumber` != @var1) && (@var2 IN v_items1.`tags`[*])))
        RETURN v_items1
      )
      COLLECT WITH COUNT INTO v_count1
      RETURN v_count1
    ) == @var3)
    SORT (v_order1.`orderNumber`)
    RETURN {
      "orderNumber": v_order1.`orderNumber`
    }
  )
}

