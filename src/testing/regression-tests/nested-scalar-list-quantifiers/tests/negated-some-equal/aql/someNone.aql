RETURN {
  "allOrders": (
    FOR v_order1
    IN @@orders
    FILTER (LENGTH((
      FOR v_items1
      IN (IS_LIST(v_order1.`items`) ? v_order1.`items` : [])
      FILTER ((IS_LIST(v_items1.`tags`) ? v_items1.`tags` : []) NONE == @var1)
      LIMIT 1
      RETURN true
    )) > 0)
    SORT (v_order1.`orderNumber`)
    RETURN {
      "orderNumber": v_order1.`orderNumber`
    }
  )
}

