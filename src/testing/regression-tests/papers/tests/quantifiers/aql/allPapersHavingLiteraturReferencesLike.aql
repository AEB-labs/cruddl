RETURN {
  "allPapers": (
    FOR v_paper1
    IN @@papers
    FILTER (LENGTH((IS_LIST(v_paper1.`literatureReferences`) ? v_paper1.`literatureReferences` : [])[* FILTER (CURRENT.`title` >= UPPER(@var1) && CURRENT.`title` < LOWER(@var2)) && (LEFT(CURRENT.`title`, LENGTH(@var3)) == @var4)]) > 0)
    SORT (v_paper1.`key`)
    RETURN {
      "key": v_paper1.`key`,
      "literatureReferences": (
        FOR v_literatureReference1
        IN v_paper1.`literatureReferences`[*]
        SORT (v_literatureReference1.`title`) , (v_literatureReference1.`pages`.`startPage`)
        RETURN {
          "title": v_literatureReference1.`title`
        }
      )
    }
  )
}

