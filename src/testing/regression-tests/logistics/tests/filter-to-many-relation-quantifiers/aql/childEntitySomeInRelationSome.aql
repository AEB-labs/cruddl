WITH @@deliveries
RETURN {
  "allForwarders": (
    FOR v_forwarder1
    IN @@forwarders
    FILTER (LENGTH((
      FOR v_deliveries1
      IN (
        FOR v_node1
        IN INBOUND v_forwarder1 @@deliveries_forwarder
        FILTER v_node1._key != null
        RETURN v_node1
      )
      FILTER (v_deliveries1.`items`[*].`quantity` ANY > @var1)
      LIMIT 1
      RETURN true
    )) > 0)
    SORT (v_forwarder1.`name`)
    RETURN {
      "name": v_forwarder1.`name`
    }
  )
}

