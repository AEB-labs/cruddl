WITH @@deliveries, @@handlingUnits
RETURN {
  "allForwarders": (
    FOR v_forwarder1
    IN @@forwarders
    FILTER (FIRST(
      FOR v_item1
      IN (
        FOR v_deliveries1
        IN INBOUND v_forwarder1 @@deliveries_forwarder
        FILTER (LENGTH((
          FOR v_node1
          IN OUTBOUND v_deliveries1 @@deliveries_handlingUnits
          FILTER v_node1._key != null
          RETURN v_node1
        )[* FILTER true]) == 0)
        FILTER v_deliveries1._key != null
        RETURN v_deliveries1
      )
      COLLECT WITH COUNT INTO v_count1
      RETURN v_count1
    ) > @var1)
    SORT (v_forwarder1.`name`)
    RETURN {
      "name": v_forwarder1.`name`
    }
  )
}

