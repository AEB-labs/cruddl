WITH @@handlingUnits
RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    FILTER (LENGTH((
      FOR v_handlingUnits1
      IN (
        FOR v_node1
        IN OUTBOUND v_delivery1 @@deliveries_handlingUnits
        FILTER v_node1._key != null
        RETURN v_node1
      )
      FILTER !((v_handlingUnits1.`huNumber` >= UPPER(@var1) && v_handlingUnits1.`huNumber` < LOWER(@var2)) && (LEFT(v_handlingUnits1.`huNumber`, LENGTH(@var3)) == @var4))
      LIMIT 1
      RETURN true
    )) == 0)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

