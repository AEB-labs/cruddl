WITH @@handlingUnits
RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    FILTER (LENGTH((
      FOR v_node1
      IN OUTBOUND v_delivery1 @@deliveries_handlingUnits
      FILTER v_node1._key != null
      RETURN v_node1
    )[* FILTER !((CURRENT.`huNumber` >= UPPER(@var1) && CURRENT.`huNumber` < LOWER(@var2)) && (LEFT(CURRENT.`huNumber`, LENGTH(@var3)) == @var4))]) == 0)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

