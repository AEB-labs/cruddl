WITH @@deliveries, @@handlingUnits
RETURN {
  "allForwarders": (
    FOR v_forwarder1
    IN @@forwarders
    FILTER (LENGTH((
      FOR v_deliveries1
      IN (
        FOR v_node1
        IN INBOUND v_forwarder1 @@deliveries_forwarder
        FILTER v_node1._key != null
        RETURN v_node1
      )
      FILTER (LENGTH((
        FOR v_handlingUnits1
        IN (
          FOR v_node2
          IN OUTBOUND v_deliveries1 @@deliveries_handlingUnits
          FILTER v_node2._key != null
          RETURN v_node2
        )
        FILTER (v_handlingUnits1.`huNumber` == @var1)
        LIMIT 1
        RETURN true
      )) > 0)
      LIMIT 1
      RETURN true
    )) > 0)
    SORT (v_forwarder1.`name`)
    RETURN {
      "name": v_forwarder1.`name`
    }
  )
}

