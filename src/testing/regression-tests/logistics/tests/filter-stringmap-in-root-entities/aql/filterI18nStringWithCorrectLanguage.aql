RETURN {
  "allCountries": (
    FOR v_country1
    IN @@countries
    FILTER (LENGTH((
      FOR v_descriptionI18nString1
      IN (
        LET v_object1 = v_country1.`descriptionI18nString`
        FOR v_key1 IN IS_DOCUMENT(v_object1) ? ATTRIBUTES(v_object1) : []
        RETURN [ v_key1, v_object1[v_key1] ]
      )
      FILTER (((v_descriptionI18nString1)[@var1] == @var2) && ((v_descriptionI18nString1)[@var3] == @var4))
      LIMIT 1
      RETURN true
    )) > 0)
    RETURN {
      "isoCode": v_country1.`isoCode`
    }
  )
}

