RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    SORT (v_delivery1.`deliveryNumber`)
    LIMIT @var1
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`,
      "contentInfo": v_delivery1.`contentInfo`[* FILTER (CURRENT.`languageIsoCode` == @var2) LIMIT @var3 RETURN {
        "translation": CURRENT.`translation`
      }],
      @var4: {
        "count": FIRST(
          FOR v_item1
          IN (
            FOR v_translation1
            IN (IS_LIST(v_delivery1.`contentInfo`) ? v_delivery1.`contentInfo` : [])
            FILTER (v_translation1.`translation` LIKE CONCAT("%", @var5, "%"))
            RETURN v_translation1
          )
          COLLECT WITH COUNT INTO v_count1
          RETURN v_count1
        )
      }
    }
  )
}

