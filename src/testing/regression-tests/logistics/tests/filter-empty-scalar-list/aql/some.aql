RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    FILTER (LENGTH((IS_LIST(v_delivery1.`serialNumbers`) ? v_delivery1.`serialNumbers` : [])[* FILTER true]) > 0)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`,
      "serialNumbers": v_delivery1.`serialNumbers`[*]
    }
  )
}

