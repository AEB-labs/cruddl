RETURN (
  FOR v_currentEntity1
  IN (
    FOR v_delivery1
    IN @@deliveries
    FILTER (v_delivery1._key == @var1)
    LIMIT @var2
    RETURN v_delivery1
  )
  UPDATE v_currentEntity1
  WITH {
    "consignee": @var3,
    "colorData": MERGE((IS_OBJECT(v_currentEntity1.`colorData`) ? v_currentEntity1.`colorData` : {}), {
      "packageColor": @var4
    }),
    "aText": @var5,
    "items": (
      FOR v_deliveryItem1
      IN (IS_LIST(v_currentEntity1.`items`) ? v_currentEntity1.`items` : [])
      RETURN ((v_deliveryItem1.`id` == @var6) ? MERGE(v_deliveryItem1, {
        "quantity": @var7,
        "updatedAt": @var8
      }) : v_deliveryItem1)
    ),
    "updatedAt": @var9
  }
  IN @@deliveries
  OPTIONS { mergeObjects: false }
  RETURN NEW._key
)

// Peak memory usage: 98304 bytes

// ----------------------------------------------------------------

WITH @@deliveries
LET v_delivery1 = DOCUMENT(@@deliveries, @var1)
RETURN (IS_NULL(v_delivery1) ? null : {
  "deliveryNumber": v_delivery1.`deliveryNumber`,
  "aText": v_delivery1.`aText`,
  "consignee": (IS_NULL(v_delivery1.`consignee`) ? null : {
    "city": v_delivery1.`consignee`.`city`
  }),
  "colorData": {
    "packageColor": v_delivery1.`colorData`.`packageColor`
  },
  "items": (
    FOR v_deliveryItem1
    IN v_delivery1.`items`[*]
    SORT (v_deliveryItem1.`itemNumber`)
    RETURN {
      "itemNumber": v_deliveryItem1.`itemNumber`,
      "quantity": v_deliveryItem1.`quantity`
    }
  )
})

// Peak memory usage: 32768 bytes

// ----------------------------------------------------------------

WITH @@deliveries
RETURN {
  "updateDelivery": @v_updateDelivery1
}

