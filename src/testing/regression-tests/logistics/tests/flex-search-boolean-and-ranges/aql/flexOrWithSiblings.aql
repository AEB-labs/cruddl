      FOR v_delivery2
      IN @@flex_view_deliveries
      SEARCH ((v_delivery2.`enumFlexSearch` IN @var1) && (ANALYZER( v_delivery2.`deliveryNumber` == TOKENS(@var2, @var3)[0],@var4) || ANALYZER( v_delivery2.`deliveryNumber` == TOKENS(@var5, @var6)[0],@var7)))
      RETURN v_delivery2
    )
    SORT (v_delivery1.`deliveryNumber`) , (v_delivery1.`createdAt`)  DESC, (v_delivery1._key)  DESC
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
