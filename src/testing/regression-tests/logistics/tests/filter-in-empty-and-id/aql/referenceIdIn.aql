RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    FILTER (LENGTH((
      FOR v_items1
      IN (IS_LIST(v_delivery1.`items`) ? v_delivery1.`items` : [])
      FILTER ((IS_NULL(v_items1.`handlingUnit`) ? null : FIRST((
        FOR v_handlingUnit1
        IN @@handlingUnits
        FILTER ((v_handlingUnit1._key > NULL) && (v_handlingUnit1._key == v_items1.`handlingUnit`))
        LIMIT @var1
        RETURN v_handlingUnit1
      )))._key IN @var2)
      LIMIT 1
      RETURN true
    )) > 0)
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

