RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    FILTER ((v_delivery1.`dispatchDate`.`timestamp` < @var1) && (v_delivery1.`dispatchDate`.`timestamp` >= @var2))
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`,
      "dispatchDate": v_delivery1.`dispatchDate`
    }
  )
}

