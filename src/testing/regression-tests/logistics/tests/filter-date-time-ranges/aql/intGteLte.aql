RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    FILTER ((v_delivery1.`aNumber` <= @var1) && (v_delivery1.`aNumber` >= @var2))
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "deliveryNumber": v_delivery1.`deliveryNumber`
    }
  )
}

