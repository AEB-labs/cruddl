RETURN {
  "allDeliveries": (
    FOR v_delivery1
    IN @@deliveries
    SORT (v_delivery1.`deliveryNumber`)
    RETURN {
      "items": (
        FOR v_deliveryItem1
        IN v_delivery1.`items`[*]
        FILTER (LENGTH((IS_LIST(v_deliveryItem1.`notes`) ? v_deliveryItem1.`notes` : [])[* FILTER (CURRENT.`text` >= UPPER(@var1) && CURRENT.`text` < LOWER(@var2))]) > 0)
        RETURN {
          "itemNumber": v_deliveryItem1.`itemNumber`,
          "notes": v_deliveryItem1.`notes`[* RETURN {
            "text": CURRENT.`text`,
            "priority": CURRENT.`priority`
          }]
        }
      )
    }
  )
}

